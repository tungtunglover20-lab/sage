# ── Discord ──────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set to your test server's ID for instant command updates while
# developing. Leave blank to register commands globally (propagation can
# take up to an hour).
DISCORD_GUILD_ID=

# ── OpenRouter (AI provider) ────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# ── App ──────────────────────────────────────────────────────────────
# development | production — affects logging format (pretty vs JSON)
NODE_ENV=production
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
