{
  "name": "dnd-sage",
  "version": "0.1.0",
  "description": "AI-powered Discord bot that answers D&D 5th Edition rules questions by retrieving relevant passages from indexed rulebook PDFs and generating source-cited answers.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "deploy": "node src/deploy-commands.js"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "openai": "^5.20.0"
  "@tavily/core": "^0.7.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "license": "MIT"
}
